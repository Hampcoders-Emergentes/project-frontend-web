# Copy to `.env` (git-ignored) and adjust. Read by Docker Compose and by scripts/generate-environment.mjs.

# Origin of the ElectroLink API, no path. Baked into the production bundle at build time.
# Local backend (Docker Compose of the API repository): http://localhost:8080
API_ORIGIN=http://localhost:8080

# Host ports for the containers
WEB_DEV_PORT=4200
WEB_PORT=8081
